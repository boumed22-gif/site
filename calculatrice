let eqn={i:0,coef:[null,null,null],sols:null,view:0};

const $=id=>document.getElementById(id);
const exprEl=$('expr'),resEl=$('res');

/* jetons simples */
const T={
  d:s=>({t:'d',d:s}),
  op:(sym,v)=>({t:'op',d:sym,v}),
  fun:(name,disp)=>({t:'fun',d:disp+'(',v:name}),
  post:(name,disp)=>({t:'post',d:disp,v:name}),
  cst:(name,disp)=>({t:'cst',d:disp,v:name}),
};
/* gabarit de fraction : {t:'tpl', wh:[]|null, nu:[], de:[]} */
const fieldsOf=tk=>tk.t==='tpl'?(tk.wh?['wh','nu','de']:['nu','de']):null;

function clearEntry(){root=[];cur={arr:root,idx:0};done=false;lastResult=null;trigKind=null;resEl.textContent=''}
function deepCopy(a){return JSON.parse(JSON.stringify(a))}

function beforeInsert(first){
  if(done&&mode!=='eqn'){
    if(first.t==='op'||first.t==='post'){
      root=[T.cst('ans','Ans')];cur={arr:root,idx:1};
    }else{root=[];cur={arr:root,idx:0}}
    done=false;lastResult=null;resEl.textContent='';
  }
}
function isValueStarter(tk){
  return tk.t==='d'||tk.t==='cst'||tk.t==='konst'||tk.t==='tpl'||tk.t==='fun'||tk.t==='hole'||
         (tk.t==='op'&&(tk.v==='('||tk.v==='u-'));
}
function eatHole(first){ // taper une valeur sur une case ▢ la remplace
  if(cur.arr[cur.idx]&&cur.arr[cur.idx].t==='hole'&&isValueStarter(first))
    cur.arr.splice(cur.idx,1);
}
function push(...ts){
  beforeInsert(ts[0]);
  eatHole(ts[0]);
  for(const tk of ts){cur.arr.splice(cur.idx,0,tk);cur.idx++}
  render();
}
function insertTpl(mixed){
  const f={t:'tpl',wh:mixed?[]:null,nu:[],de:[]};
  beforeInsert(f);
  eatHole(f);
  cur.arr.splice(cur.idx,0,f);
  cur={arr:mixed?f.wh:f.nu,idx:0};   // curseur dans le 1er champ
  render();
}

/* ---- localiser le parent d'un conteneur dans l'arbre ---- */
function locate(target,arr){
  arr=arr||root;
  for(let i=0;i<arr.length;i++){
    const tk=arr[i],fs=fieldsOf(tk);
    if(!fs)continue;
    for(const f of fs){
      if(tk[f]===target)return {tok:tk,field:f,parentArr:arr,tokIdx:i};
      const r=locate(target,tk[f]);if(r)return r;
    }
  }
  return null;
}

/* ---- navigation aux 4 flèches ---- */
function reopenIfDone(toStart){
  if(done&&mode!=='eqn'){
    done=false;lastResult=null;resEl.textContent='';
    cur={arr:root,idx:toStart?0:root.length};
    return true;
  }
  return false;
}
function navRight(){
  if(reopenIfDone(true)){render();return}
  if(cur.idx<cur.arr.length){
    const tk=cur.arr[cur.idx];
    const fs=fieldsOf(tk);
    if(fs)cur={arr:tk[fs[0]],idx:0};    // entrer dans la fraction
    else cur.idx++;
    render();return;
  }
  const loc=locate(cur.arr);
  if(!loc){render();return}
  const fs=fieldsOf(loc.tok),fi=fs.indexOf(loc.field);
  if(fi<fs.length-1)cur={arr:loc.tok[fs[fi+1]],idx:0};     // champ suivant
  else cur={arr:loc.parentArr,idx:loc.tokIdx+1};           // sortir après
  render();
}
function navLeft(){
  if(reopenIfDone(false)){render();return}
  if(cur.idx>0){
    const tk=cur.arr[cur.idx-1];
    const fs=fieldsOf(tk);
    if(fs){const last=tk[fs[fs.length-1]];cur={arr:last,idx:last.length}}
    else cur.idx--;
    render();return;
  }
  const loc=locate(cur.arr);
  if(!loc){render();return}
  const fs=fieldsOf(loc.tok),fi=fs.indexOf(loc.field);
  if(fi>0){const prev=loc.tok[fs[fi-1]];cur={arr:prev,idx:prev.length}}
  else cur={arr:loc.parentArr,idx:loc.tokIdx};
  render();
}
function navDown(){
  if(mode==='eqn'&&eqn.sols)return eqnCycle(1);
  const loc=locate(cur.arr);
  if(loc){ // dans une fraction : descendre au champ suivant (numérateur → dénominateur)
    const fs=fieldsOf(loc.tok),fi=fs.indexOf(loc.field);
    if(fi<fs.length-1){cur={arr:loc.tok[fs[fi+1]],idx:0};render()}
    return;
  }
  // au niveau racine : replay avant
  if(history.length&&histPos<history.length-1){
    histPos++;loadHist();
  }
}
function navUp(){
  if(mode==='eqn'&&eqn.sols)return eqnCycle(-1);
  const loc=locate(cur.arr);
  if(loc){ // remonter au champ précédent (dénominateur → numérateur)
    const fs=fieldsOf(loc.tok),fi=fs.indexOf(loc.field);
    if(fi>0){const p=loc.tok[fs[fi-1]];cur={arr:p,idx:p.length};render()}
    return;
  }
  // au niveau racine : replay arrière
  if(history.length){
    histPos=Math.max(0,histPos-1);loadHist();
  }
}
function loadHist(){
  root=deepCopy(history[histPos]);
  cur={arr:root,idx:root.length};
  done=false;lastResult=null;resEl.textContent='';render();
}
function del(){
  if(done&&mode!=='eqn'){done=false;lastResult=null;resEl.textContent=''}
  if(cur.idx>0){cur.arr.splice(cur.idx-1,1);cur.idx--}
  else{
    const loc=locate(cur.arr);
    if(loc)cur={arr:loc.parentArr,idx:loc.tokIdx}; // sortir devant la fraction
  }
  render();
}

/* ================= Touches ================= */
const keyMap={
