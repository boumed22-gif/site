    if(f&&f.d!==1&&Math.abs(toX(f)-x)<1e-10*Math.max(1,Math.abs(x)))r=f;
  }
  if(r&&r.d!==1&&!forceDec){
    const sgn=r.n<0?'−':'';
    if(showMixed&&Math.abs(r.n)>r.d){
      const w=Math.floor(Math.abs(r.n)/r.d),rem=Math.abs(r.n)%r.d;
      return sgn+w+'<span class="fr"><span class="nu">'+rem+'</span><span class="de">'+r.d+'</span></span>';
    }
    return sgn+'<span class="fr"><span class="nu">'+Math.abs(r.n)+'</span><span class="de">'+r.d+'</span></span>';
  }
  return fmt(toX(v));
}
function valSign(v){return (isR(v)?v.n:v.x)<0?-1:1}
function valAbs(v){return isR(v)?R(Math.abs(v.n),v.d):{x:Math.abs(v.x)}}
function isOne(v){return isR(v)&&v.n===1&&v.d===1}

/* ---- module exact en racine : √(p/q) affiché m√rest / q ---- */
function surdHtml(r2){
  if(showDec||!isR(r2)||r2.n<0||r2.n*r2.d>1e12)return fmt(Math.sqrt(toX(r2)));
  let k=r2.n*r2.d,m=1,rest=k;
  for(let i=2;i*i<=rest;i++){while(rest%(i*i)===0){rest/=i*i;m*=i}}
  if(rest===1)return valHtml(R(m,r2.d),showDec);          // carré parfait
  const g=gcd(m,r2.d),mm=m/g,qq=r2.d/g;
  const nuh=(mm===1?'':mm)+'√'+rest;
  if(qq===1)return nuh;
  return '<span class="fr"><span class="nu">'+nuh+'</span><span class="de">'+qq+'</span></span>';
}
/* ---- argument exact en fraction de π (π/4, 3π/4, −π/2…) ---- */
function argPiHtml(z){
  const th=Math.atan2(toX(imOf(z)),toX(reOf(z)));
  const f=toFrac(th/Math.PI,24);
  if(f&&!showDec&&Math.abs(toX(f)-th/Math.PI)<1e-9){
    if(f.n===0)return '0';
    const sgn=f.n<0?'−':'';
    const a=Math.abs(f.n);
    const nuh=(a===1?'':a)+'π';
    if(f.d===1)return sgn+nuh;
    return sgn+'<span class="fr"><span class="nu">'+nuh+'</span><span class="de">'+f.d+'</span></span>';
  }
  if(deg)return trim((th*180/Math.PI).toPrecision(8))+'°';
  return trim(th.toPrecision(8));
}
/* ---- l'expression est-elle exactement sin⁻¹(...), cos⁻¹(...) ou tan⁻¹(...) ? ---- */
function wholeInverseTrig(){
  if(!root.length)return null;
  const t0=root[0];
  if(t0.t!=='fun'||!['asin','acos','atan'].includes(t0.v))return null;
  let depth=1;
  for(let i=1;i<root.length;i++){
    const tk=root[i];
    if(tk.t==='fun'||(tk.t==='op'&&tk.v==='('))depth++;
    else if(tk.t==='op'&&tk.v===')'){
      depth--;
      if(depth===0&&i<root.length-1)return null;   // il y a une suite après la fonction
    }
  }
  return t0.v;
}
function piFracHtml(f){
  if(f.n===0)return '0';
  const sgn=f.n<0?'−':'';
  const a=Math.abs(f.n);
  const nuh=(a===1?'':a)+'π';
  if(f.d===1)return sgn+nuh;
  return sgn+'<span class="fr"><span class="nu">'+nuh+'</span><span class="de">'+f.d+'</span></span>';
}
/* ---- les DEUX solutions de sinφ=a, cosφ=a, tanφ=a ---- */
function trigSolHtml(v){
  const angleH=x=>{
    if(!deg&&!showDec){
      const t=toX(x)/Math.PI;
      const f=toFrac(t,24);
      if(f&&Math.abs(toX(f)-t)<1e-9)return piFracHtml(f);
    }
    return valHtml(x,showDec);
  };
  const per=trigKind==='atan'?(deg?'+k·180°':'+kπ'):(deg?'+k·360°':'+2kπ');
  const perH='&nbsp;<span style="font-size:.55em;opacity:.75">'+per+'</span>';
  if(trigKind==='atan')return angleH(v)+perH;          // tan : une famille, période π
  let v2;
  if(trigKind==='asin')v2=deg?sub(R(180,1),v):{x:Math.PI-toX(v)};   // π − φ
  else v2=gneg(v);                                                   // cos : ± φ
  if(Math.abs(toX(v)-toX(v2))<1e-9)return angleH(v)+perH;            // φ=90°, φ=0…
  if(trigKind==='acos')return '±'+angleH(v)+perH;
  return angleH(v)+'&nbsp;<span style="font-size:.65em;opacity:.85">ou</span>&nbsp;'+angleH(v2)+perH;
}
function showRes(v,label){
  if(trigKind&&!isC(v)&&!(label||'')){
    resEl.innerHTML=trigSolHtml(v);
    resEl.scrollLeft=0;
    return;
  }
  label=label||'';
  let html;
  if(isC(v)){
    const form=showPolar|0;
    if(form===1||form===2){
      const r2=add(mul(v.re,v.re),mul(v.im,v.im));   // r² exact
      const rH=surdHtml(r2);
      const tH=argPiHtml(v);
      const rPart=(rH==='1')?'':rH+'&nbsp;';
      const negT=tH.startsWith('−');
      const expo=(negT?'−𝑖':'𝑖')+(negT?tH.slice(1):tH);
      if(form===1)
        html=rPart+'e<sup class="ei">'+expo+'</sup>';                        // forme exponentielle
      else
        html=rPart+'(cos&nbsp;'+tH+'&nbsp;+&nbsp;𝑖&nbsp;sin&nbsp;'+tH+')';  // forme trigonométrique
    }else{
      const re=v.re,im=v.im;
      const parts=[];
      if(!zeroV(re))parts.push(valHtml(re,showDec));
      if(!zeroV(im)){
        const s=valSign(im)<0?'−':(parts.length?'+':'');
        const a=valAbs(im);
        parts.push(s+(isOne(a)?'':valHtml(a,showDec))+'𝑖');
      }
      html=parts.length?parts.join(''):'0';
    }
  }else{
    html=valHtml(v,showDec);
  }
  const lbl=label?'<span style="margin-right:auto;font-size:.75em;opacity:.8">'+label+'</span>':'';
  resEl.innerHTML=lbl+html;
  resEl.scrollLeft=resEl.scrollWidth;
}
function fmt(x){
  if(!isFinite(x)||isNaN(x))return 'Math ERREUR';
  if(x===0)return '0';
  const ax=Math.abs(x);
  if(ax>=1e10||ax<1e-9){
    const e=Math.floor(Math.log10(ax));
    const m=x/Math.pow(10,e);
    return trim(m.toPrecision(10))+'<sup class="e">×10</sup><sup>'+e+'</sup>';
  }
  return trim(x.toPrecision(10));
}
function trim(s){
  if(s.indexOf('.')>=0)s=s.replace(/0+$/,'').replace(/\.$/,'');
  return s.replace('-','−');
}

