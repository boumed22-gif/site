function curLabel(){
  if(mode==='eqn'&&eqn.sols)return eqn.sols[eqn.view].lbl;
  return '';
}

/* ---- notation ingénieur : 1530 → 1.53×10³ → 1530×10⁰ → … ---- */
function engPress(dir){
  if(lastResult==null&&!compute(true))return;
  if(isC(lastResult))return;                 // réels uniquement
  const x=toX(lastResult);
  if(engExp===null){
    trigKind=null;
    if(x===0){engExp=0}
    else{
      const e=Math.floor(Math.log10(Math.abs(x)));
      engExp=3*Math.floor(e/3);              // exposant multiple de 3
    }
  }else{
    engExp+=dir*3;                           // ENG : ×10³ vers la mantisse ; ← : inverse
    if(engExp>99)engExp=99;
    if(engExp<-99)engExp=-99;
  }
  const m=x/Math.pow(10,engExp);
  const lbl=curLabel();
  const lblHtml=lbl?'<span style="margin-right:auto;font-size:.75em;opacity:.8">'+lbl+'</span>':'';
  resEl.innerHTML=lblHtml+trim(m.toPrecision(10))+'<sup class="e">×10</sup><sup>'+engExp+'</sup>';
  resEl.scrollLeft=resEl.scrollWidth;
}

function equals(){
  if(done||root.length===0)return;
  try{
    const tkTrig=wholeInverseTrig();
    const v=evalList(root);
    if(mode!=='cmplx')assertReal(v);
    trigKind=(tkTrig&&!isC(v))?tkTrig:null;
    ans=v;lastResult=v;showDec=false;showMixed=false;showPolar=false;engExp=null;done=true;
    history.push(deepCopy(root));if(history.length>40)history.shift();
    histPos=history.length;
    showRes(v);render();
  }catch(err){
    lastResult=null;done=true;
    resEl.textContent=(err==='MATH')?'Math ERREUR':(err==='HOLE'?'Compléter les ▢':'Syntaxe ERREUR');
    render();
  }
}
function compute(silent){
  if(lastResult!=null)return true;
  try{const v=evalList(root);ans=v;lastResult=v;done=true;showRes(v);return true}
  catch(e){if(!silent){resEl.textContent='Erreur'}return false}
}

/* ================= Mode EQN ================= */
const EQN_PROMPTS=['a?','b?','c?'];
function eqnReset(){eqn={i:0,coef:[null,null,null],sols:null,view:0};clearEntry()}
function eqnCycle(dir){
  eqn.view=(eqn.view+dir+eqn.sols.length)%eqn.sols.length;
  const s=eqn.sols[eqn.view];
  lastResult=s.v;showDec=false;showMixed=false;showPolar=false;engExp=null;
  showRes(s.v,s.lbl);
}
function eqnEnter(){
  if(eqn.sols)return eqnCycle(1);
  let v;
  trigKind=null;
  try{v=root.length?assertReal(evalList(root)):R(0,1)}
  catch(err){resEl.textContent=(err==='MATH')?'Math ERREUR':'Syntaxe ERREUR';return}
  eqn.coef[eqn.i]=v;eqn.i++;
  root=[];cur={arr:root,idx:0};
  if(eqn.i<3){resEl.textContent='';render();return}
  eqnSolve();
}
function eqnSolve(){
  const [a,b,c]=eqn.coef;
  try{
    if(zeroV(a)){
      if(zeroV(b))throw"MATH";
      eqn.sols=[{lbl:'x=',v:div(neg(c),b)}];
    }else{
      const D=sub(mul(b,b),mul(R(4,1),mul(a,c)));
      const two=mul(R(2,1),a);
      const dX=toX(D);
      if(dX>0){
        const s=sqrtVal(D);
        eqn.sols=[
          {lbl:'x₁=',v:div(add(neg(b),s),two)},
          {lbl:'x₂=',v:div(sub(neg(b),s),two)},
          {lbl:'Δ=',v:D}];
      }else if(dX===0){
        eqn.sols=[{lbl:'x=',v:div(neg(b),two)},{lbl:'Δ=',v:D}];
      }else{
        const s=sqrtVal(neg(D));
        const p=div(neg(b),two),q=div(s,two);
        eqn.sols=[
          {lbl:'x₁=',v:C(p,q)},
          {lbl:'x₂=',v:C(p,neg(q))},
          {lbl:'Δ=',v:D}];
      }
    }
    eqn.view=0;
    const s0=eqn.sols[0];
    lastResult=s0.v;showDec=false;showMixed=false;showPolar=false;engExp=null;done=true;
    showRes(s0.v,s0.lbl);render();
  }catch(err){
    resEl.textContent='Math ERREUR';eqn.i=0;eqn.coef=[null,null,null];render();
  }
}

/* ================= Évaluation (récursive sur l'arbre) ================= */
function evalList(tokArr){
  const list=[];
  for(const tk of tokArr){
    if(tk.t==='d'){
      const last=list[list.length-1];
      if(last&&last.t==='num')last.s+=tk.d;
      else list.push({t:'num',s:tk.d});
    }else list.push(tk);
  }
  let p=0;
  const peek=()=>list[p];
  const next=()=>list[p++];

  function expr(){
    let a=term();
    while(peek()&&peek().t==='op'&&(peek().v==='+'||peek().v==='-')){
      const o=next().v;const b=term();
      a=o==='+'?gadd(a,b):gsub(a,b);
    }
    return a;
  }
  function term(){
    let a=unaryless();
    for(;;){
      const tk=peek();
      if(tk&&tk.t==='op'&&(tk.v==='*'||tk.v==='/'||tk.v==='P'||tk.v==='C')){
        const o=next().v;const b=unaryless();
        if(o==='*')a=gmul(a,b);
        else if(o==='/')a=gdiv(a,b);
        else{
          assertReal(a);assertReal(b);
          const n=toX(a),r=toX(b);
          if(!isR(a)||!isR(b)||a.d!==1||b.d!==1||n<0||r<0||r>n||n>69)throw"MATH";
          let v=toX(fact(a))/toX(fact(R(n-r,1)));
          if(o==='C')v/=toX(fact(b));
          a=R(Math.round(v),1);
        }
      }
      else if(tk&&(tk.t==='num'||tk.t==='cst'||tk.t==='konst'||tk.t==='fun'||tk.t==='tpl'||(tk.t==='op'&&tk.v==='(')))
        a=gmul(a,unaryless());   // multiplication implicite
      else break;
    }
    return a;
  }
  function unaryless(){return power()}
  function power(){
    const a=postfixed();
    const tk=peek();
    if(tk&&tk.t==='op'&&tk.v==='^'){next();return gpow(a,unary())}
    if(tk&&tk.t==='op'&&tk.v==='root'){next();const b=unary();return gpow(b,gdiv(R(1,1),a))}
    if(tk&&tk.t==='op'&&tk.v==='E'){next();return gmul(a,rpow(R(10,1),assertReal(unary())))}
    return a;
  }
  function unary(){
    const tk=peek();
    if(tk&&tk.t==='op'&&(tk.v==='u-'||tk.v==='-')){next();return gneg(unary())}
    if(tk&&tk.t==='op'&&tk.v==='+'){next();return unary()}
    return power();
  }
  function postfixed(){
    let a=atom();
    for(;;){
      const tk=peek();
      if(!tk||tk.t!=='post')break;
      next();
      switch(tk.v){
        case 'sq':a=gpow(a,R(2,1));break;
        case 'cube':a=gpow(a,R(3,1));break;
        case 'inv':a=gdiv(R(1,1),a);break;
        case 'fact':a=fact(assertReal(a));break;
        case 'pct':a=gdiv(a,R(100,1));break;
      }
    }
    return a;
  }
  function atom(){
    const tk=next();
    if(!tk)throw"SYN";
    if(tk.t==='hole')throw"HOLE";
    if(tk.t==='num'){
      if(tk.s==='.'||(tk.s.match(/\./g)||[]).length>1)throw"SYN";
      return decToR(tk.s);
    }
    if(tk.t==='tpl'){ // gabarit de fraction (récursif)
      if(!tk.nu.length||!tk.de.length)throw"SYN";
      const f=gdiv(evalList(tk.nu),evalList(tk.de));
      if(tk.wh){ // fraction mixte : e + n/d (signe porté par la partie entière)
        if(!tk.wh.length)throw"SYN";
        const w=assertReal(evalList(tk.wh));
        assertReal(f);
        const s=toX(w)<0?-1:1;
        return gadd(w,gmul(R(s,1),f));
      }
      return f;
    }
    if(tk.t==='konst')return {x:tk.x};
    if(tk.t==='cst'){
      if(tk.v==='pi')return {x:Math.PI};
      if(tk.v==='e')return {x:Math.E};
      if(tk.v==='i'){if(mode!=='cmplx')throw"SYN";return C(R(0,1),R(1,1))}
      if(tk.v==='ans')return ans;
    }
    if(tk.t==='op'&&(tk.v==='u-'||tk.v==='-'))return gneg(unary());
    if(tk.t==='op'&&tk.v==='('){
      const v=expr();
      if(peek()&&peek().v===')')next();
      return v;
    }
    if(tk.t==='fun'){
      const v=expr();
      if(peek()&&peek().v===')')next();
      return applyFun(tk.v,v);
    }
    throw"SYN";
  }
  const out=expr();
  if(p<list.length)throw"SYN";
  return out;
}
function applyFun(name,v){
  const toRad=x=>deg?x*Math.PI/180:x;
  const fromRad=x=>deg?x*180/Math.PI:x;
  if(isC(v)){
    switch(name){
      case 'abs':return cabs(v);
      case 'arg':return carg(v);
      case 'conj':return conj(v);
      case 'sqrt':return csqrt(v);
      default:throw"MATH";
    }
  }
  switch(name){
    case 'abs':return cabs(v);
    case 'arg':return carg(v);
    case 'conj':return v;
    case 'sin':{const r=Math.sin(toRad(toX(v)));return snap({x:r})}
    case 'cos':{const r=Math.cos(toRad(toX(v)));return snap({x:r})}
    case 'tan':{
      const a=toRad(toX(v));
      if(Math.abs(Math.cos(a))<1e-12)throw"MATH";
      return snap({x:Math.tan(a)});
    }
    case 'asin':{const x=toX(v);if(x<-1||x>1)throw"MATH";return snapDeg(fromRad(Math.asin(x)))}
    case 'acos':{const x=toX(v);if(x<-1||x>1)throw"MATH";return snapDeg(fromRad(Math.acos(x)))}
    case 'atan':return snapDeg(fromRad(Math.atan(toX(v))));
    case 'log':{const x=toX(v);if(x<=0)throw"MATH";return {x:Math.log10(x)}}
    case 'ln':{const x=toX(v);if(x<=0)throw"MATH";return {x:Math.log(x)}}
    case 'sqrt':return csqrt(v);
    case 'cbrt':{
      const x=Math.cbrt(toX(v));
      if(Math.abs(x-Math.round(x))<1e-10)return R(Math.round(x),1);
      return {x};
    }
  }
  throw"SYN";
}
function snap(v){
  const x=v.x;
  if(Math.abs(x)<1e-12)return R(0,1);
  const f=toFrac(x,64);
  if(f&&Math.abs(toX(f)-x)<1e-10)return f;
  return v;
}
function snapDeg(x){
  const r=Math.round(x*1e10)/1e10;
  return Number.isInteger(r)?R(r,1):{x:r};
}

