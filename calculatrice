<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>NovaSci S·One — Calculatrice Scientifique</title>
<style>
:root{
  --page:#e9edfb;
  --frame:#ffffff;
  --face-hi:#fbfcff;
  --face-lo:#f1f4fe;
  --lcd:#f4f6ff;
  --lcd-ink:#2c3061;
  --key-dark:#e3e7fa;
  --key-dark-hi:#eef1fd;
  --key-light:#ffffff;
  --key-orange:#ff7a66;
  --shiftc:#00b8d9;
  --violet:#7a5cff;
  --gold:#7a5cff;
  --ink:#2c3061;
}
*{box-sizing:border-box;margin:0;padding:0;-webkit-tap-highlight-color:transparent}
html,body{height:100%}
body{
  background:radial-gradient(120% 90% at 50% 0%,#ffffff 0%,var(--page) 62%);
  font-family:system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;
  display:flex;align-items:flex-start;justify-content:center;
  padding:14px 8px 40px;
  color:#2c3061;
}
.calc{
  width:min(420px,100%);
  background:linear-gradient(165deg,#8f7bff,#5ad2ee 55%,#7a5cff);
  border-radius:30px;
  padding:8px;
  box-shadow:0 24px 60px rgba(122,92,255,.35);
}
.face{
  background:linear-gradient(175deg,var(--face-hi),var(--face-lo));
  border-radius:24px;
  padding:14px 14px 18px;
  box-shadow:inset 0 2px 0 #ffffff,inset 0 -2px 8px rgba(105,90,220,.08);
}
.brand{
  display:flex;justify-content:space-between;align-items:baseline;
  padding:2px 4px 8px;color:var(--ink);
}
.brand .logo{font-weight:800;letter-spacing:.2em;font-size:1.04rem;color:#2c3061}
.brand .logo span{color:var(--violet);font-weight:800}
.brand .model{font-weight:800;font-size:.9rem;letter-spacing:.14em;color:var(--shiftc)}
.brand-sub{
  text-align:center;color:#9aa2c6;font-weight:700;letter-spacing:.3em;
  font-size:.6rem;padding-bottom:8px;
}
/* ---------- LCD ---------- */
.lcd{
  background:linear-gradient(180deg,#e9edff,var(--lcd) 40%);
  border:2px solid #d5dcf7;
  border-radius:16px;
  box-shadow:inset 0 3px 10px rgba(105,90,220,.12),0 0 0 3px rgba(122,92,255,.06);
  padding:6px 10px 8px;
  min-height:112px;
  display:flex;flex-direction:column;
  color:var(--lcd-ink);
  font-family:ui-monospace,"Cascadia Mono",Consolas,monospace;
  position:relative;
}
.lcd .status{
  display:flex;gap:12px;font-size:.62rem;font-weight:700;letter-spacing:.06em;
  min-height:14px;
}
.lcd .status .on{opacity:1}
.lcd .status .off{opacity:.13}
.lcd .expr{
  flex:1;font-size:1.28rem;line-height:1.25;
  overflow-x:auto;overflow-y:hidden;white-space:nowrap;
  display:flex;align-items:center;gap:1px;
  scrollbar-width:none;padding:2px 0;
}
.lcd .expr::-webkit-scrollbar{display:none}
.lcd .res{
  text-align:right;font-size:1.7rem;font-weight:600;min-height:2.1rem;
  overflow-x:auto;white-space:nowrap;scrollbar-width:none;
  display:flex;justify-content:flex-end;align-items:center;
}
.lcd .res::-webkit-scrollbar{display:none}
.cursor{display:inline-block;width:9px;height:1.25em;background:var(--lcd-ink);
  animation:blink 1s steps(1) infinite;vertical-align:middle;margin-left:1px}
@keyframes blink{50%{opacity:0}}
/* stacked fraction */
.fr{display:inline-flex;flex-direction:column;align-items:center;vertical-align:middle;
  line-height:1.05;font-size:.82em;margin:0 2px}
.fr .nu{border-bottom:1.5px solid currentColor;padding:0 3px}
.fr .de{padding:0 3px}
.mixed{display:inline-flex;align-items:center;gap:2px}
sup.e{font-size:.6em;vertical-align:super}
sup.ei{font-size:.62em;vertical-align:super}
sup.ei .fr{font-size:.9em}
/* ---------- keys ---------- */
.keys{margin-top:14px;display:flex;flex-direction:column;gap:9px}
.row{display:grid;gap:9px}
.r3{grid-template-columns:1.2fr 1.2fr 1fr 1fr 1.2fr}
.r6{grid-template-columns:repeat(6,1fr)}
.r5{grid-template-columns:repeat(5,1fr)}
.kwrap{display:flex;flex-direction:column;align-items:stretch}
.klabel{
  font-size:.56rem;font-weight:800;text-align:center;color:var(--violet);
  min-height:12px;letter-spacing:.02em;
  overflow:hidden;white-space:nowrap;
}
button.k{
  border:1.5px solid #d8ddf5;cursor:pointer;user-select:none;
  border-radius:14px;
  padding:9px 2px;
  font-size:.95rem;font-weight:800;
  font-family:inherit;
  color:#4a4f86;background:linear-gradient(180deg,var(--key-dark-hi),var(--key-dark));
  box-shadow:0 3px 0 #cfd5f0,0 4px 8px rgba(105,90,220,.12);
  transition:transform .05s,filter .12s;
  line-height:1.15;
}
button.k:active{transform:translateY(2px);box-shadow:0 1px 0 #cfd5f0}
button.k.num{
  color:var(--ink);
  background:linear-gradient(180deg,#ffffff,var(--key-light) 55%,#f2f4fe);
  box-shadow:0 3px 0 #d4daf2,0 4px 8px rgba(105,90,220,.12);
  font-size:1.15rem;padding:11px 2px;border-color:#e0e4f8;
}
button.k.num:active{box-shadow:0 1px 0 #d4daf2}
button.k.act{
  background:linear-gradient(180deg,#ff9a89,var(--key-orange) 60%,#f25a44);
  color:#fff;border-color:#f0664f;
  box-shadow:0 3px 0 #d64a37,0 4px 10px rgba(255,122,102,.35);
  font-size:1rem;
}
button.k.shiftk{
  background:linear-gradient(180deg,#3fd6ef,#00b8d9 60%,#0096b4);
  color:#fff;border-color:#00a3c2;
  box-shadow:0 3px 0 #0089a5,0 4px 10px rgba(0,184,217,.35);
}
button.k.shiftk.armed{filter:brightness(1.12);outline:3px solid #aef0fc}
button.k:focus-visible{outline:2px solid var(--shiftc);outline-offset:2px}
button.k .small{font-size:.72em;font-weight:600}
.footer{
  margin-top:12px;text-align:center;color:#9aa2c6;font-size:.6rem;letter-spacing:.12em;
  font-weight:700;
}
.footer i{color:var(--violet);font-style:normal}
/* ---------- pavé directionnel REPLAY ---------- */
.toparea{display:grid;grid-template-columns:1fr auto 1fr;gap:9px;align-items:start}
.tcol{display:flex;flex-direction:column;gap:8px}
.dpad{
  width:116px;height:116px;border-radius:50%;
  margin:2px auto 0;position:relative;
  background:radial-gradient(circle at 38% 30%,#ffffff,#e7ebfc 62%,#d9dff8);
  box-shadow:0 4px 12px rgba(105,90,220,.18),inset 0 2px 3px #ffffff,inset 0 -3px 6px rgba(105,90,220,.15);
  display:grid;grid-template-columns:repeat(3,1fr);grid-template-rows:repeat(3,1fr);
}
.dk{
  border:none;background:transparent;color:var(--violet);cursor:pointer;
  font-size:.9rem;font-weight:800;padding:0;line-height:1;
  transition:color .1s,transform .05s;
}
.dk:active{color:var(--shiftc);transform:scale(.85)}
.du{grid-area:1/2}.dl{grid-area:2/1}.dr{grid-area:2/3}.dd{grid-area:3/2}
.dcenter{
  grid-area:2/2;border-radius:50%;
  background:radial-gradient(circle at 40% 32%,#f2f4ff,#dde2f8);
  box-shadow:inset 0 2px 4px rgba(105,90,220,.2),0 1px 0 #ffffff;
  display:flex;align-items:center;justify-content:center;
  font-size:.42rem;letter-spacing:.08em;color:#8a91bb;font-weight:800;
  margin:3px;
}
/* ---------- gabarit de fraction naturelle ---------- */
.fr.tpl{font-size:.9em}
.fr .nu,.fr .de{min-width:.9em;min-height:1.05em;display:flex;align-items:center;justify-content:center;gap:1px}
.ph{
  display:inline-block;width:.85em;height:1.05em;
  border:1.6px dashed currentColor;border-radius:3px;
  opacity:.5;vertical-align:middle;
}
sub{font-size:.6em}
.phv{border-color:#7a5cff;opacity:.85}
.cptabs{display:flex;gap:6px;padding-bottom:8px}
.cptab{
  flex:1;border:none;border-radius:10px;padding:8px 4px;
  font-weight:800;font-family:inherit;font-size:.72rem;letter-spacing:.06em;
  background:#f0f2fd;color:#8a91bb;cursor:pointer;
}
.cptab.on{background:#7a5cff;color:#fff}
.fitem{
  display:flex;flex-direction:column;gap:2px;align-items:flex-start;
  border:1.5px solid #e7eafb;border-radius:12px;padding:8px 10px;
  background:#fbfcff;cursor:pointer;text-align:left;font-family:inherit;
  transition:border-color .1s,background .1s;
}
.fitem:active,.fitem:hover{border-color:#00b8d9;background:#effbfe}
.fitem .ff{font-size:.95rem;font-weight:800;color:#2c3061}
.fitem .ff .fr{font-size:.8em}
.fitem .fn{font-size:.68rem;color:#8a91bb;font-weight:700}
/* ---------- panneau CONSTANTES ---------- */
.calc{position:relative}
.cpanel{
  position:absolute;inset:8px;z-index:30;display:none;
  background:#ffffff;border-radius:24px;
  box-shadow:0 18px 50px rgba(44,48,97,.35);
  padding:14px;overflow:hidden;
  display:none;flex-direction:column;
}
.cpanel.open{display:flex}
.cphead{display:flex;align-items:center;gap:8px;padding-bottom:10px}
.cphead .cpt{font-weight:800;color:#2c3061;font-size:.85rem;letter-spacing:.1em;flex:1}
.cpx{
  border:none;background:#f0f2fd;color:#7a5cff;font-weight:800;
  width:32px;height:32px;border-radius:10px;font-size:1rem;cursor:pointer;
}
.cpsearch{
  width:100%;border:2px solid #e0e4f8;border-radius:12px;
  padding:10px 12px;font-size:.95rem;font-family:inherit;color:#2c3061;
  outline:none;background:#f7f8ff;
}
.cpsearch:focus{border-color:#7a5cff}
.cplist{flex:1;overflow-y:auto;margin-top:10px;display:flex;flex-direction:column;gap:6px;padding-right:2px}
.citem{
  display:grid;grid-template-columns:52px 1fr;gap:2px 10px;align-items:center;
  border:1.5px solid #e7eafb;border-radius:12px;padding:8px 10px;
  background:#fbfcff;cursor:pointer;text-align:left;font-family:inherit;
  transition:border-color .1s,background .1s;
}
.citem:active,.citem:hover{border-color:#7a5cff;background:#f4f1ff}
.citem .cs{grid-row:1/3;font-size:1.15rem;font-weight:800;color:#7a5cff;text-align:center}
.citem .cn{font-size:.72rem;font-weight:700;color:#2c3061}
.citem .cv{font-size:.72rem;color:#00a3c2;font-weight:700}
.cpempty{text-align:center;color:#9aa2c6;font-size:.8rem;padding:18px 0}
@media (max-width:380px){
  button.k{font-size:.85rem;border-radius:10px}
  button.k.num{font-size:1.05rem}
  .lcd .expr{font-size:1.15rem}
  .lcd .res{font-size:1.5rem}
}
</style>
</head>
<body>
<div class="calc" id="calc">
  <div class="face">
    <div class="brand">
      <div class="logo">NOVA<span>SCI</span></div>
      <div class="model">S·ONE</div>
    </div>
    <div class="brand-sub">CALCULATRICE&nbsp;SCIENTIFIQUE</div>

    <div class="lcd" aria-live="polite">
      <div class="status">
        <span id="stS" class="off">S</span>
        <span id="stM" class="off">M</span>
        <span id="stMode" class="off">CMPLX</span>
        <span style="margin-left:auto" id="stDRG" class="on">DEG</span>
        <span id="stMath" class="on">2D</span>
      </div>
      <div class="expr" id="expr"><span class="cursor"></span></div>
      <div class="res" id="res"></div>
    </div>

    <div class="keys">
      <!-- rangée haute : SHIFT/MODE, pavé REPLAY 4 flèches, ON -->
      <div class="toparea">
        <div class="tcol">
          <div class="kwrap"><div class="klabel">&nbsp;</div>
            <button class="k shiftk" id="btnShift" data-a="shift">SHIFT</button></div>
          <div class="kwrap"><div class="klabel">DEG⇄RAD</div>
            <button class="k" data-a="mode">MODE</button></div>
        </div>
        <div class="dpad" aria-label="pavé directionnel REPLAY">
          <button class="dk du" data-a="up" aria-label="haut">▲</button>
          <button class="dk dl" data-a="left" aria-label="gauche">◄</button>
          <div class="dcenter">REPLAY</div>
          <button class="dk dr" data-a="right" aria-label="droite">►</button>
          <button class="dk dd" data-a="down" aria-label="bas">▼</button>
        </div>
        <div class="tcol">
          <div class="kwrap"><div class="klabel">OFF</div>
            <button class="k" data-a="on">ON</button></div>
          <div class="kwrap"><div class="klabel">←</div>
            <button class="k" data-k="eng" data-s="engrev">ENG</button></div>
          <div class="kwrap"><div class="klabel">h, c, Nₐ…</div>
            <button class="k" data-a="const" style="color:#7a5cff">CONST</button></div>
        </div>
      </div>

      <!-- fonctions -->
      <div class="row r6">
        <div class="kwrap"><div class="klabel">x!</div>
          <button class="k" data-k="inv" data-s="fact">x<sup>-1</sup></button></div>
        <div class="kwrap"><div class="klabel">³√</div>
          <button class="k" data-k="sqrt" data-s="cbrt">√</button></div>
        <div class="kwrap"><div class="klabel">x³</div>
          <button class="k" data-k="sq" data-s="cube">x²</button></div>
        <div class="kwrap"><div class="klabel">ˣ√</div>
          <button class="k" data-k="pow" data-s="xroot">x<sup>▪</sup></button></div>
        <div class="kwrap"><div class="klabel">10^x</div>
          <button class="k" data-k="log" data-s="tenpow">log</button></div>
        <div class="kwrap"><div class="klabel">e^x</div>
          <button class="k" data-k="ln" data-s="epow">ln</button></div>
      </div>

      <div class="row r6">
        <div class="kwrap"><div class="klabel" id="lblNeg">&nbsp;</div>
          <button class="k" id="btnNeg" data-k="neg">(−)</button></div>
        <div class="kwrap"><div class="klabel">▪<span style="font-size:.8em">▫⁄▫</span></div>
          <button class="k" data-k="frac" data-s="mixedtpl"><span class="fr" style="font-size:.72em"><span class="nu">▪</span><span class="de">▪</span></span></button></div>
        <div class="kwrap"><div class="klabel">&nbsp;</div>
          <button class="k" data-k="pi">π</button></div>
        <div class="kwrap"><div class="klabel" id="lblSin">sin⁻¹</div>
          <button class="k" id="btnSin" data-k="sin" data-s="asin">sin</button></div>
        <div class="kwrap"><div class="klabel" id="lblCos">cos⁻¹</div>
          <button class="k" id="btnCos" data-k="cos" data-s="acos">cos</button></div>
        <div class="kwrap"><div class="klabel" id="lblTan">tan⁻¹</div>
          <button class="k" id="btnTan" data-k="tan" data-s="atan">tan</button></div>
      </div>

      <div class="row r6">
        <div class="kwrap"><div class="klabel" id="lblE">&nbsp;</div>
          <button class="k" id="btnE" data-k="e">e</button></div>
        <div class="kwrap"><div class="klabel" id="lblOpen">&nbsp;</div>
          <button class="k" id="btnOpen" data-k="open">(</button></div>
        <div class="kwrap"><div class="klabel" id="lblClose">&nbsp;</div>
          <button class="k" id="btnClose" data-k="close">)</button></div>
        <div class="kwrap"><div class="klabel" id="lblSD">a b/c⇄d/c</div>
          <button class="k" data-k="sd" data-s="mixed">S⇔D</button></div>
        <div class="kwrap"><div class="klabel">M−</div>
          <button class="k" data-k="mplus" data-s="mminus">M+</button></div>
        <div class="kwrap"><div class="klabel">Mémoire</div>
          <button class="k" data-k="rcl" data-s="mclr">RCL</button></div>
      </div>

      <!-- pavé numérique -->
      <div class="row r5">
        <div class="kwrap"><div class="klabel">&nbsp;</div><button class="k num" data-k="7">7</button></div>
        <div class="kwrap"><div class="klabel">&nbsp;</div><button class="k num" data-k="8">8</button></div>
        <div class="kwrap"><div class="klabel">&nbsp;</div><button class="k num" data-k="9">9</button></div>
        <div class="kwrap"><div class="klabel">&nbsp;</div><button class="k act" data-a="del">DEL</button></div>
        <div class="kwrap"><div class="klabel">&nbsp;</div><button class="k act" data-a="ac">AC</button></div>
      </div>
      <div class="row r5">
        <div class="kwrap"><div class="klabel">&nbsp;</div><button class="k num" data-k="4">4</button></div>
        <div class="kwrap"><div class="klabel">&nbsp;</div><button class="k num" data-k="5">5</button></div>
        <div class="kwrap"><div class="klabel">&nbsp;</div><button class="k num" data-k="6">6</button></div>
        <div class="kwrap"><div class="klabel">nPr</div><button class="k num" data-k="mul" data-s="npr">×</button></div>
        <div class="kwrap"><div class="klabel">nCr</div><button class="k num" data-k="div" data-s="ncr">÷</button></div>
      </div>
      <div class="row r5">
        <div class="kwrap"><div class="klabel">&nbsp;</div><button class="k num" data-k="1">1</button></div>
        <div class="kwrap"><div class="klabel">&nbsp;</div><button class="k num" data-k="2">2</button></div>
        <div class="kwrap"><div class="klabel">&nbsp;</div><button class="k num" data-k="3">3</button></div>
        <div class="kwrap"><div class="klabel">&nbsp;</div><button class="k num" data-k="plus">+</button></div>
        <div class="kwrap"><div class="klabel">&nbsp;</div><button class="k num" data-k="minus">−</button></div>
      </div>
      <div class="row r5">
        <div class="kwrap"><div class="klabel">&nbsp;</div><button class="k num" data-k="0">0</button></div>
        <div class="kwrap"><div class="klabel">Ran#</div><button class="k num" data-k="dot" data-s="ran">·</button></div>
        <div class="kwrap"><div class="klabel">&nbsp;</div><button class="k num" data-k="exp">×10<sup>x</sup></button></div>
        <div class="kwrap"><div class="klabel">%</div><button class="k num" data-k="ans" data-s="pct">Ans</button></div>
        <div class="kwrap"><div class="klabel">&nbsp;</div><button class="k num" data-k="eq">=</button></div>
      </div>
    </div>

    <div class="footer">© NOVASCI 2026 <i>•</i> ÉCRITURE MATHÉMATIQUE 2D <i>•</i> MODES COMP · CMPLX · EQN</div>
  </div>
  <!-- panneau des constantes physiques -->
  <div class="cpanel" id="cpanel">
    <div class="cphead">
      <div class="cpt">BIBLIOTHÈQUE SCIENTIFIQUE</div>
      <button class="cpx" id="cpclose" aria-label="fermer">✕</button>
    </div>
    <div class="cptabs">
      <button class="cptab on" id="tabConst">CONSTANTES</button>
      <button class="cptab" id="tabForm">FORMULES</button>
    </div>
    <input class="cpsearch" id="cpsearch" type="text" inputmode="search"
           placeholder="Rechercher… (lumière, masse, boltzmann…)" autocomplete="off">
    <div class="cplist" id="cplist"></div>
  </div>
</div>

<script>
"use strict";
/* ================= Rationnels exacts ================= */
function gcd(a,b){a=Math.abs(a);b=Math.abs(b);while(b){[a,b]=[b,a%b]}return a||1}
function R(n,d){
  if(d===0) throw "MATH";
  if(d<0){n=-n;d=-d}
  const g=gcd(n,d);n/=g;d/=g;
  if(!isFinite(n)||!isFinite(d)||Math.abs(n)>1e15||d>1e15) return {x:n/d};
  return {n,d};
}
const isR=v=>v.n!==undefined;
const toX=v=>isR(v)?v.n/v.d:v.x;
function decToR(s){
  const i=s.indexOf('.');
  if(i<0) return R(parseInt(s,10)||0,1);
  const dec=s.slice(i+1);
  const n=parseInt(s.replace('.',''),10)||0;
  return R(n,Math.pow(10,dec.length));
}
const add=(a,b)=>(isR(a)&&isR(b))?R(a.n*b.d+b.n*a.d,a.d*b.d):{x:toX(a)+toX(b)};
const sub=(a,b)=>(isR(a)&&isR(b))?R(a.n*b.d-b.n*a.d,a.d*b.d):{x:toX(a)-toX(b)};
const mul=(a,b)=>(isR(a)&&isR(b))?R(a.n*b.n,a.d*b.d):{x:toX(a)*toX(b)};
function div(a,b){
  if(isR(a)&&isR(b)){if(b.n===0)throw"MATH";return R(a.n*b.d,a.d*b.n)}
  const x=toX(b);if(x===0)throw"MATH";return {x:toX(a)/x};
}
const neg=a=>isR(a)?R(-a.n,a.d):{x:-a.x};
const zeroV=v=>isR(v)?v.n===0:v.x===0;
function rpow(a,b){
  if(isR(b)&&b.d===1&&Math.abs(b.n)<=1000&&isR(a)){
    let e=b.n,base=a;
    if(e<0){base=div(R(1,1),a);e=-e}
    let r=R(1,1);
    for(let i=0;i<e;i++){r=mul(r,base);if(!isR(r))break}
    if(isR(r))return r;
  }
  const x=Math.pow(toX(a),toX(b));
  if(!isFinite(x)||isNaN(x))throw"MATH";
  return {x};
}
function fact(a){
  const x=toX(a);
  if(!isR(a)||a.d!==1||x<0||x>69)throw"MATH";
  let r=1;for(let i=2;i<=x;i++)r*=i;return R(r,1);
}
function sqrtVal(v){
  const x=toX(v);
  if(x<0)throw"MATH";
  if(isR(v)){const sn=Math.sqrt(v.n),sd=Math.sqrt(v.d);
    if(Number.isInteger(sn)&&Number.isInteger(sd))return R(sn,sd)}
  return {x:Math.sqrt(x)};
}
function toFrac(x,maxD){
  maxD=maxD||1e6;
  let s=x<0?-1:1;x=Math.abs(x);
  let h1=1,h0=0,k1=0,k0=1,b=x;
  for(let i=0;i<40;i++){
    const a=Math.floor(b);
    const h=a*h1+h0,k=a*k1+k0;
    if(k>maxD)break;
    h0=h1;h1=h;k0=k1;k1=k;
    if(Math.abs(h/k-x)<1e-11)break;
    const f=b-a;if(f<1e-12)break;b=1/f;
  }
  if(k1===0)return null;
  if(Math.abs(h1/k1-x)<1e-9){
    const out=R(s*h1,k1);
    return isR(out)?out:null;   // débordement → pas de fraction
  }
  return null;
}

/* ================= Nombres complexes ================= */
const C=(re,im)=>({re,im});
const isC=v=>v.re!==undefined;
const reOf=v=>isC(v)?v.re:v;
const imOf=v=>isC(v)?v.im:R(0,1);
const simp=z=>isC(z)&&zeroV(z.im)?z.re:z;
function assertReal(v){if(isC(v))throw"MATH";return v}
function gadd(a,b){
  if(isC(a)||isC(b))return simp(C(add(reOf(a),reOf(b)),add(imOf(a),imOf(b))));
  return add(a,b);
}
function gsub(a,b){
  if(isC(a)||isC(b))return simp(C(sub(reOf(a),reOf(b)),sub(imOf(a),imOf(b))));
  return sub(a,b);
}
function gmul(a,b){
  if(isC(a)||isC(b)){
    const ar=reOf(a),ai=imOf(a),br=reOf(b),bi=imOf(b);
    return simp(C(sub(mul(ar,br),mul(ai,bi)),add(mul(ar,bi),mul(ai,br))));
  }
  return mul(a,b);
}
function gdiv(a,b){
  if(isC(a)||isC(b)){
    const ar=reOf(a),ai=imOf(a),br=reOf(b),bi=imOf(b);
    const den=add(mul(br,br),mul(bi,bi));
    if(zeroV(den))throw"MATH";
    return simp(C(div(add(mul(ar,br),mul(ai,bi)),den),
                  div(sub(mul(ai,br),mul(ar,bi)),den)));
  }
  return div(a,b);
}
const gneg=a=>isC(a)?C(neg(a.re),neg(a.im)):neg(a);
function gpow(a,b){
  if(!isC(a)&&!isC(b))return rpow(a,b);
  if(!isC(b)&&isR(b)&&b.d===1&&Math.abs(b.n)<=200){
    let e=b.n,base=a;
    if(e<0){base=gdiv(R(1,1),a);e=-e}
    let r=R(1,1);
    for(let i=0;i<e;i++)r=gmul(r,base);
    return r;
  }
  const zr=toX(reOf(a)),zi=toX(imOf(a));
  const wr=toX(reOf(b)),wi=toX(imOf(b));
  const m=Math.hypot(zr,zi);
  if(m===0){if(wr>0&&wi===0)return R(0,1);throw"MATH"}
  const th=Math.atan2(zi,zr);
  const lnm=Math.log(m);
  const nr=Math.exp(wr*lnm-wi*th);
  const na=wi*lnm+wr*th;
  return simp(C({x:nr*Math.cos(na)},{x:nr*Math.sin(na)}));
}
function cabs(z){
  if(!isC(z)){const x=toX(z);return isR(z)?R(Math.abs(z.n),z.d):{x:Math.abs(x)}}
  return sqrtVal(add(mul(z.re,z.re),mul(z.im,z.im)));
}
function carg(z){
  const x=toX(reOf(z)),y=toX(imOf(z));
  if(x===0&&y===0)throw"MATH";
  let a=Math.atan2(y,x);
  if(deg)a=a*180/Math.PI;
  return snapDeg(a);
}
const conj=z=>isC(z)?simp(C(z.re,neg(z.im))):z;
function csqrt(z){
  if(!isC(z)){
    const x=toX(z);
    if(x>=0)return sqrtVal(z);
    if(mode!=='cmplx')throw"MATH";
    return C(R(0,1),sqrtVal(gneg(z)));
  }
  const x=toX(z.re),y=toX(z.im);
  const m=Math.hypot(x,y),th=Math.atan2(y,x)/2,r=Math.sqrt(m);
  return simp(C({x:r*Math.cos(th)},{x:r*Math.sin(th)}));
}

/* ================= État ================= */
let root=[];                       // arbre de saisie
let cur={arr:root,idx:0};          // curseur : conteneur + position
let shift=false;
let deg=true;
let mem=R(0,1);
let ans=R(0,1);
let lastResult=null;
let showDec=false;
let showMixed=false;
let showPolar=false;
