  for(let i=0;i<arr.length;i++){
    const tk=arr[i];
    if(tk.t==='hole')return {arr,idx:i};
    const fs=fieldsOf(tk);
    if(fs)for(const f of fs){const r=firstHole(tk[f]);if(r)return r}
  }
  return null;
}
function insertFormula(toks){
  if(done&&mode!=='eqn')clearEntry();
  eatHole(toks[0]);
  const at=cur.idx;
  for(const tk of toks){cur.arr.splice(cur.idx,0,tk);cur.idx++}
  const fh=firstHole(toks.length?cur.arr.slice(at,at+toks.length):[]);
  // retrouver la position réelle dans l'arbre
  const fh2=firstHole(root);
  if(fh2)cur=fh2;
  render();
}
const norm=s=>s.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g,'');
let cpTab='const';
function openConst(){
  $('cpanel').classList.add('open');
  $('cpsearch').value='';
  fillConst('');
  setTimeout(()=>$('cpsearch').focus(),50);
}
function closeConst(){$('cpanel').classList.remove('open')}
function setTab(t){
  cpTab=t;
  $('tabConst').classList.toggle('on',t==='const');
  $('tabForm').classList.toggle('on',t==='form');
  $('cpsearch').placeholder=t==='const'
    ?'Rechercher… (lumière, masse, boltzmann…)'
    :'Rechercher… (énergie, ohm, gaz, pH…)';
  fillConst($('cpsearch').value);
}
function fillConst(q){
  q=norm(q.trim());
  const list=$('cplist');
  if(cpTab==='const'){
    const items=KONST.filter(c=>!q||norm(c.s+' '+c.n+' '+c.k).includes(q));
    if(!items.length){list.innerHTML='<div class="cpempty">Aucune constante trouvée</div>';return}
    list.innerHTML=items.map(c=>{
      const i=KONST.indexOf(c);
      return '<button class="citem" data-ci="'+i+'">'+
        '<span class="cs">'+c.h+'</span>'+
        '<span class="cn">'+c.n+'</span>'+
        '<span class="cv">'+c.u+'</span></button>';
    }).join('');
    list.querySelectorAll('.citem').forEach(b=>{
      b.addEventListener('click',()=>{
        const c=KONST[+b.dataset.ci];
        closeConst();
        push({t:'konst',d:c.s,h:c.h,x:c.v});
      });
    });
  }else{
    const items=FORMULES.filter(f=>!q||norm(f.n+' '+f.k).includes(q));
    if(!items.length){list.innerHTML='<div class="cpempty">Aucune formule trouvée</div>';return}
    list.innerHTML=items.map(f=>{
      const i=FORMULES.indexOf(f);
      return '<button class="fitem" data-fi="'+i+'">'+
        '<span class="ff">'+f.f+'</span>'+
        '<span class="fn">'+f.n+' — les '+BOX+' sont à compléter</span></button>';
    }).join('');
    list.querySelectorAll('.fitem').forEach(b=>{
      b.addEventListener('click',()=>{
        const f=FORMULES[+b.dataset.fi];
        closeConst();
        insertFormula(f.b());
      });
    });
  }
}

/* ================= Événements ================= */
document.querySelectorAll('button.k, button.dk').forEach(b=>{
  b.addEventListener('click',()=>{
    const a=b.dataset.a;
    if(uiMenu){
      const k=b.dataset.k;
      if(k==='1')return setMode('comp');
      if(k==='2')return setMode('cmplx');
      if(k==='3')return setMode('eqn');
      if(a==='ac'||a==='on'||a==='mode'){uiMenu=false;render()}
      return;
    }
    if(a==='const'){shift=false;openConst();return}
    if(a==='shift'){shift=!shift;render();return}
    if(a==='mode'){
      if(shift){deg=!deg;shift=false;render();return}
      uiMenu=true;render();return;
    }
    if(a==='on'){setMode('comp');deg=true;mem=R(0,1);history=[];histPos=-1;return}
    if(a==='ac'){
      shift=false;
      if(mode==='eqn'){eqnReset();render();return}
      clearEntry();render();return;
    }
    if(a==='del'){del();return}
    if(a==='up'){shift=false;navUp();return}
    if(a==='down'){shift=false;navDown();return}
    if(a==='left'){shift=false;navLeft();return}
    if(a==='right'){shift=false;navRight();return}
    const k=(shift&&b.dataset.s)?b.dataset.s:b.dataset.k;
    shift=false;
    if(k&&keyMap[k])keyMap[k]();
    render();
  });
});

$('cpclose').addEventListener('click',closeConst);
$('cpsearch').addEventListener('input',e=>fillConst(e.target.value));
$('tabConst').addEventListener('click',()=>setTab('const'));
$('tabForm').addEventListener('click',()=>setTab('form'));

/* clavier physique */
window.addEventListener('keydown',e=>{
  if($('cpanel').classList.contains('open')){
    if(e.key==='Escape')closeConst();
    return;                                   // le panneau capture le clavier
  }
  if(uiMenu){
    if(e.key==='1')return setMode('comp');
    if(e.key==='2')return setMode('cmplx');
    if(e.key==='3')return setMode('eqn');
    if(e.key==='Escape'){uiMenu=false;render()}
    return;
  }
  if(e.key==='ArrowUp'){navUp();e.preventDefault();return}
  if(e.key==='ArrowDown'){navDown();e.preventDefault();return}
  if(e.key==='ArrowLeft'){navLeft();e.preventDefault();return}
  if(e.key==='ArrowRight'){navRight();e.preventDefault();return}
  const m={'+':'plus','-':'minus','*':'mul','/':'div','^':'pow','(':'open',')':'close',
    '.':'dot','!':'fact','%':'pct','p':'pi','e':'e','i':'i','a':'ans','s':'sin','c':'cos','t':'tan',
    'l':'log','n':'ln','r':'sqrt','f':'frac'};
  if(e.key>='0'&&e.key<='9'){keyMap[e.key]();e.preventDefault();return}
  if(e.key==='Enter'||e.key==='='){keyMap.eq();e.preventDefault();return}
  if(e.key==='Backspace'){del();e.preventDefault();return}
  if(e.key==='Escape'){mode==='eqn'?eqnReset():clearEntry();render();return}
  if(e.key==='Shift'){shift=!shift;render();return}
  if(e.key.toLowerCase()==='i'&&mode!=='cmplx')return;
  const k=m[e.key.toLowerCase()];
  if(k){keyMap[k]();e.preventDefault()}
});

render();

</script>
